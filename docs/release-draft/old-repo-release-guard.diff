# PROPOSAL for the ORIGINAL repo (PoE_Price-Trade_Checker) - NOT applied, waits for Winai's approval (the old repo is read only for me).
#
# Once the TypeScript programs are released as "Latest" on foolshang/PoE-Filter-Generator, the original's release.yml must not be able to
# create a release, rewrite the README or deploy the page there any more. The least invasive guard keeps the workflow (and its history)
# and switches off the three publishing steps: a tag push still builds the exe (a quick check that the old program still builds), but
# publishes nothing; a deliberate legacy release is still possible by hand: workflow_dispatch with a tag that contains "legacy"
# (which is a prerelease because of the "-"; write it like v0.99.0-legacy).
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ web:
-    if: ${{ !contains(github.event_name == 'workflow_dispatch' && inputs.version || github.ref_name, '-') }}
+    if: ${{ false }}        # deploy-web.yml of the TypeScript repo owns the page now
@@ - name: Publish release to public repo
+        if: ${{ github.event_name == 'workflow_dispatch' && contains(inputs.version, 'legacy') }}   # the TypeScript release owns "Latest" now
@@ - name: Update README in public repo
-        if: ${{ !contains(steps.ver.outputs.tag, '-') && needs.web.result == 'success' }}
+        if: ${{ false }}        # the README of the public repo is the TypeScript one now
